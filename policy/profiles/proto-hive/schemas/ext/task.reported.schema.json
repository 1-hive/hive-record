{
  "$id": "https://github.com/1-hive/hive-record/policy/profiles/proto-hive/schemas/ext/task.reported.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "cost": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "usd_micros": {
          "type": "integer",
          "minimum": 0
        },
        "tokens": {
          "type": "integer",
          "minimum": 0
        },
        "wall_clock_seconds": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "model": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100,
      "description": "A7: the model that wrote this event's content, as the actor's harness reported it; absent when unknown."
    }
  }
}
