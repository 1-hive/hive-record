{
  "$id": "https://github.com/1-hive/hive-record/policy/profiles/1-hive/schemas/events/goal.proposed.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "project",
    "title",
    "objective",
    "relevance",
    "budget"
  ],
  "properties": {
    "project": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$",
      "maxLength": 64
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "objective": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    },
    "relevance": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "usd_micros": {
          "type": "integer",
          "minimum": 0
        },
        "tokens": {
          "type": "integer",
          "minimum": 0
        },
        "wall_clock_seconds": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
