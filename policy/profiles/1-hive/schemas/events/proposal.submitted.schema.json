{
  "$id": "https://github.com/1-hive/hive-record/policy/profiles/1-hive/schemas/events/proposal.submitted.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "proposal_id",
    "proposed",
    "approver_class"
  ],
  "properties": {
    "proposal_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$",
      "maxLength": 64
    },
    "proposed": {
      "type": "object"
    },
    "approver_class": {
      "type": "string",
      "enum": [
        "operator",
        "chief_of_staff",
        "coordinator"
      ]
    }
  }
}
