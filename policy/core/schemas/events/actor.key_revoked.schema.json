{
  "$id": "https://github.com/1-hive/hive-record/policy/core/schemas/events/actor.key_revoked.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "actor_id",
    "key",
    "reason"
  ],
  "properties": {
    "actor_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$",
      "maxLength": 64
    },
    "key": {
      "type": "string",
      "pattern": "^ed25519:[A-Za-z0-9_-]{43}$",
      "maxLength": 51
    },
    "reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    }
  }
}
