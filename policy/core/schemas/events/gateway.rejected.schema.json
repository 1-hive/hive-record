{
  "$id": "https://github.com/1-hive/hive-record/policy/core/schemas/events/gateway.rejected.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "code",
    "reason",
    "retryable",
    "by",
    "refused",
    "refused_digest",
    "refused_size",
    "detail"
  ],
  "properties": {
    "code": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]*$",
      "maxLength": 64
    },
    "reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "retryable": {
      "type": "boolean"
    },
    "by": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "class"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$",
          "maxLength": 64
        },
        "class": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$",
          "maxLength": 64
        }
      }
    },
    "via": {
      "type": "string",
      "maxLength": 64
    },
    "refused": {
      "type": [
        "object",
        "null"
      ]
    },
    "refused_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$",
      "maxLength": 71
    },
    "refused_size": {
      "type": "integer",
      "minimum": 0
    },
    "detail": {
      "type": "object"
    }
  }
}
