{
  "$id": "https://github.com/1-hive/hive-record/policy/core/schemas/events/review.recorded.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "verdict",
    "result_event"
  ],
  "properties": {
    "verdict": {
      "type": "string",
      "enum": [
        "passed",
        "failed",
        "needs_information"
      ]
    },
    "result_event": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "maxLength": 36
    },
    "ext": {
      "type": "object"
    }
  }
}
