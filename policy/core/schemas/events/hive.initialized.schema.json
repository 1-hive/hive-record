{
  "$id": "https://github.com/1-hive/hive-record/policy/core/schemas/events/hive.initialized.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mode",
    "profile",
    "registry_digest",
    "operator"
  ],
  "properties": {
    "mode": {
      "type": "string",
      "enum": [
        "authoritative",
        "mirror"
      ]
    },
    "profile": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$",
      "maxLength": 64
    },
    "registry_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$",
      "maxLength": 71
    },
    "operator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "role",
        "keys",
        "declaration"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$",
          "maxLength": 64
        },
        "role": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "keys": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^ed25519:[A-Za-z0-9_-]{43}$",
            "maxLength": 51
          }
        },
        "declaration": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "harness",
            "model_route",
            "sandbox"
          ],
          "properties": {
            "harness": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "model_route": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "sandbox": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            }
          }
        }
      }
    }
  }
}
