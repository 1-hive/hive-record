{
  "$id": "https://github.com/1-hive/hive-record/policy/core/schemas/events/exception.advised.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "exception_id",
    "recommendation",
    "reason"
  ],
  "properties": {
    "exception_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$",
      "maxLength": 64
    },
    "recommendation": {
      "type": "string",
      "enum": [
        "grant",
        "deny"
      ]
    },
    "reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    }
  }
}
