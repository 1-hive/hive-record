{
  "$id": "https://github.com/1-hive/hive-record/policy/core/schemas/events/route.drift_detected.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "route_id",
    "route_pin",
    "attempt",
    "pinned_model",
    "observed_models",
    "log"
  ],
  "properties": {
    "route_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$",
      "maxLength": 64
    },
    "route_pin": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$",
      "maxLength": 71
    },
    "attempt": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "task": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$",
      "maxLength": 64
    },
    "pinned_model": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "observed_models": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      },
      "uniqueItems": true
    },
    "log": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "seq",
        "digest"
      ],
      "description": "The router's full, replayable entry for this event: its seq in the router's log and the SHA-256 of its canonical line.",
      "properties": {
        "seq": {
          "type": "integer",
          "minimum": 1
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$",
          "maxLength": 71
        }
      }
    }
  }
}
