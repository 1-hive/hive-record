{
  "$id": "https://github.com/1-hive/hive-record/policy/core/schemas/events/route.decided.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "task",
    "attempt",
    "mode",
    "table",
    "tier",
    "computed_tier",
    "route_id",
    "route_pin",
    "pool",
    "model",
    "rules",
    "log"
  ],
  "properties": {
    "task": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$",
      "maxLength": 64
    },
    "attempt": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "mode": {
      "type": "string",
      "enum": [
        "live",
        "fixed"
      ]
    },
    "table": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$",
      "maxLength": 71
    },
    "tier": {
      "type": "string",
      "enum": [
        "local",
        "light",
        "standard",
        "strong"
      ]
    },
    "computed_tier": {
      "type": "string",
      "enum": [
        "local",
        "light",
        "standard",
        "strong"
      ]
    },
    "route_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$",
      "maxLength": 64
    },
    "route_pin": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$",
      "maxLength": 71
    },
    "pool": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$",
      "maxLength": 64
    },
    "model": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "effort": {
      "type": "string",
      "minLength": 1,
      "maxLength": 32
    },
    "harness": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "facts": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "specification": {
          "type": "string",
          "enum": [
            "explicit",
            "partial",
            "goal_only"
          ]
        },
        "verification": {
          "type": "string",
          "enum": [
            "independent",
            "weak",
            "none"
          ]
        },
        "scope": {
          "type": "string",
          "enum": [
            "single",
            "few",
            "many"
          ]
        },
        "consequence": {
          "type": "string",
          "enum": [
            "reversible",
            "costly"
          ]
        },
        "estimated": {
          "type": "array",
          "maxItems": 4,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "specification",
              "verification",
              "scope",
              "consequence"
            ]
          }
        }
      }
    },
    "rules": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z][A-Za-z0-9_]{0,15}$",
        "maxLength": 16
      },
      "uniqueItems": true
    },
    "log": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "seq",
        "digest"
      ],
      "description": "The router's full, replayable entry for this event: its seq in the router's log and the SHA-256 of its canonical line.",
      "properties": {
        "seq": {
          "type": "integer",
          "minimum": 1
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$",
          "maxLength": 71
        }
      }
    }
  }
}
