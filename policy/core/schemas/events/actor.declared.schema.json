{
  "$id": "https://github.com/1-hive/hive-record/policy/core/schemas/events/actor.declared.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "actor_id",
    "declaration"
  ],
  "properties": {
    "actor_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$",
      "maxLength": 64
    },
    "declaration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "harness",
        "model_route",
        "sandbox"
      ],
      "properties": {
        "harness": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "model_route": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "sandbox": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        }
      }
    }
  }
}
