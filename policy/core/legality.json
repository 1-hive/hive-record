{
  "schema": "hive.legality/1",
  "version": "1.1.0",
  "classes": ["operator", "coordinator", "worker", "reviewer", "instrument", "arbiter", "gateway"],
  "rels": ["order", "question", "answer", "result", "review", "report", "policy", "role_prompt", "rationale"],
  "codes": ["SCHEMA_INVALID", "UNSUPPORTED_SCHEMA", "UNKNOWN_EVENT_TYPE", "PAYLOAD_TOO_LARGE", "STALE_GENERATION", "STALE_REVISION", "IDEMPOTENCY_CONFLICT", "KEY_EXISTS", "UNKNOWN_KEY", "NOT_AUTHORIZED", "NOT_OWNER", "UNKNOWN_ACTOR", "ACTOR_RETIRED", "ACTOR_EXISTS", "UNKNOWN_PROJECT", "PROJECT_EXISTS", "PROJECT_NOT_OPEN", "PROJECT_HAS_OPEN_WORK", "UNKNOWN_TASK", "TASK_EXISTS", "ILLEGAL_TRANSITION", "INVALID_ASSIGNEE", "NOT_ANSWERED", "REF_MISSING", "REF_NOT_ALLOWED", "PIN_INVALID", "PIN_UNAVAILABLE", "POLICY_INVALID", "REVIEW_REQUIRED", "REVIEW_STALE", "REVIEW_NOT_INDEPENDENT", "REVIEW_NOT_ASSIGNED", "LAST_OPERATOR", "UNKNOWN_EXCEPTION", "EXCEPTION_EXISTS", "EXCEPTION_NOT_PENDING", "REFUSAL_MISMATCH", "NOT_EXCEPTABLE", "EXCEPTION_NOT_APPLICABLE", "INTERNAL_ERROR"],
  "waivable_codes": ["ILLEGAL_TRANSITION", "INVALID_ASSIGNEE", "NOT_ANSWERED", "PROJECT_NOT_OPEN"],
  "entities": {
    "hive": {"collection": null, "id": null, "state_field": "mode", "states": ["authoritative", "mirror"], "terminal": [], "unknown_code": "ILLEGAL_TRANSITION", "exists_code": "ILLEGAL_TRANSITION", "illegal_code": "ILLEGAL_TRANSITION", "mirrorable": false},
    "project": {"collection": "projects", "id": "data.project", "state_field": "status", "states": ["open", "closed"], "terminal": ["closed"], "unknown_code": "UNKNOWN_PROJECT", "exists_code": "PROJECT_EXISTS", "illegal_code": "PROJECT_NOT_OPEN", "mirrorable": false},
    "actor": {"collection": "actors", "id": "data.actor_id", "state_field": "status", "states": ["active", "retired"], "terminal": ["retired"], "unknown_code": "UNKNOWN_ACTOR", "exists_code": "ACTOR_EXISTS", "illegal_code": "ACTOR_RETIRED", "mirrorable": false},
    "task": {"collection": "tasks", "id": "task", "state_field": "status", "states": ["created", "assigned", "in_progress", "blocked", "in_review", "done", "cancelled"], "terminal": ["done", "cancelled"], "unknown_code": "UNKNOWN_TASK", "exists_code": "TASK_EXISTS", "illegal_code": "ILLEGAL_TRANSITION", "mirrorable": true},
    "exception": {"collection": "exceptions", "id": "data.exception_id", "state_field": "status", "states": ["pending", "granted", "denied", "withdrawn"], "terminal": ["granted", "denied", "withdrawn"], "unknown_code": "UNKNOWN_EXCEPTION", "exists_code": "EXCEPTION_EXISTS", "illegal_code": "EXCEPTION_NOT_PENDING", "mirrorable": false}
  },
  "inbox": {
    "operator": ["task_blocked_unanswered", "task_passed_not_closed", "task_review_unassigned", "exception_pending"],
    "arbiter": ["exception_pending"]
  },
  "rules": [
    {"event": "hive.initialized", "entity": "hive", "classes": ["gateway"], "relation": null, "from": null, "to": {"by": "mode", "map": {"authoritative": "authoritative", "mirror": "mirror"}}, "refs": {"required": ["policy"], "allowed": []}, "conditions": ["log_empty"], "effects": ["init_hive"]},
    {"event": "hive.policy_changed", "entity": "hive", "classes": ["operator"], "relation": null, "from": "*", "to": "same", "refs": {"required": ["policy"], "allowed": []}, "conditions": [], "effects": ["set_policy"]},
    {"event": "hive.registry_changed", "entity": "hive", "classes": ["operator"], "relation": null, "from": "*", "to": "same", "refs": {"required": [], "allowed": []}, "conditions": [], "effects": ["set_registry"]},
    {"event": "hive.mode_changed", "entity": "hive", "classes": ["operator"], "relation": null, "from": ["mirror"], "to": "authoritative", "refs": {"required": [], "allowed": []}, "conditions": [], "effects": []},
    {"event": "gateway.started", "entity": "hive", "classes": ["gateway"], "relation": null, "from": "*", "to": "same", "refs": {"required": [], "allowed": []}, "conditions": [], "effects": ["record_gateway"]},
    {"event": "gateway.rejected", "entity": "hive", "classes": ["gateway"], "relation": null, "from": "*", "to": "same", "refs": {"required": [], "allowed": []}, "conditions": [], "effects": []},
    {"event": "project.opened", "entity": "project", "classes": ["coordinator", "operator"], "relation": null, "from": null, "to": "open", "refs": {"required": [], "allowed": []}, "conditions": [], "effects": ["open_project"]},
    {"event": "project.closed", "entity": "project", "classes": ["operator"], "relation": null, "from": ["open"], "to": "closed", "refs": {"required": [], "allowed": []}, "conditions": ["project_has_no_open_work"], "effects": []},
    {"event": "actor.registered", "entity": "actor", "classes": ["operator"], "relation": null, "from": null, "to": "active", "refs": {"required": [], "allowed": ["role_prompt"]}, "conditions": ["class_registrable", "keys_unused"], "effects": ["register_actor"]},
    {"event": "actor.declared", "entity": "actor", "classes": "*", "relation": "self", "from": ["active"], "to": "same", "refs": {"required": [], "allowed": ["role_prompt"]}, "conditions": [], "effects": ["update_declaration"]},
    {"event": "actor.retired", "entity": "actor", "classes": ["operator"], "relation": null, "from": ["active"], "to": "retired", "refs": {"required": [], "allowed": []}, "conditions": ["not_last_operator"], "effects": []},
    {"event": "actor.key_added", "entity": "actor", "classes": ["operator"], "relation": null, "from": ["active"], "to": "same", "refs": {"required": [], "allowed": []}, "conditions": ["key_unused"], "effects": ["add_key"]},
    {"event": "actor.key_revoked", "entity": "actor", "classes": "*", "relation": "self", "from": "*", "to": "same", "refs": {"required": [], "allowed": []}, "conditions": ["key_is_actors"], "effects": ["revoke_key"]},
    {"event": "task.created", "entity": "task", "classes": ["coordinator", "operator"], "relation": null, "from": null, "to": "created", "refs": {"required": ["order"], "allowed": []}, "conditions": ["project_open_if_given"], "effects": ["create_task"], "exceptable": true},
    {"event": "task.assigned", "entity": "task", "classes": ["coordinator", "operator"], "relation": null, "from": ["created"], "to": "assigned", "refs": {"required": [], "allowed": []}, "conditions": [{"name": "target_active_class", "args": ["worker", "reviewer"]}], "effects": ["set_owner"], "exceptable": true},
    {"event": "task.accepted", "entity": "task", "classes": ["worker", "reviewer"], "relation": "owner", "from": ["assigned"], "to": "in_progress", "refs": {"required": [], "allowed": []}, "conditions": [], "effects": [], "exceptable": true},
    {"event": "task.declined", "entity": "task", "classes": ["worker", "reviewer"], "relation": "owner", "from": ["assigned"], "to": "created", "refs": {"required": [], "allowed": []}, "conditions": [], "effects": ["clear_owner"], "exceptable": true},
    {"event": "task.blocked", "entity": "task", "classes": ["worker", "reviewer"], "relation": "owner", "from": ["in_progress"], "to": "blocked", "refs": {"required": ["question"], "allowed": []}, "conditions": [], "effects": ["record_block"], "exceptable": true},
    {"event": "task.answered", "entity": "task", "classes": ["coordinator", "operator"], "relation": null, "from": ["blocked"], "to": "same", "refs": {"required": ["answer"], "allowed": []}, "conditions": [], "effects": ["record_answer"], "exceptable": true},
    {"event": "task.unblocked", "entity": "task", "classes": ["worker", "reviewer"], "relation": "owner", "from": ["blocked"], "to": "in_progress", "refs": {"required": [], "allowed": []}, "conditions": ["answered_if_needed"], "effects": ["clear_block"], "exceptable": true},
    {"event": "task.reported", "entity": "task", "classes": ["worker", "reviewer"], "relation": "owner", "from": ["assigned", "in_progress", "blocked", "in_review"], "to": "same", "refs": {"required": ["report"], "allowed": []}, "conditions": [], "effects": [], "exceptable": true},
    {"event": "task.result_posted", "entity": "task", "classes": ["worker", "reviewer"], "relation": "owner", "from": ["in_progress"], "to": "in_review", "refs": {"required": ["result"], "allowed": []}, "conditions": [], "effects": ["set_current_result"], "exceptable": true},
    {"event": "review.assigned", "entity": "task", "classes": ["coordinator", "operator"], "relation": null, "from": ["in_review"], "to": "same", "refs": {"required": [], "allowed": []}, "conditions": ["targets_current_result", {"name": "target_active_class", "args": ["reviewer"]}, "assigned_reviewer_not_author"], "effects": ["assign_reviewer"]},
    {"event": "review.recorded", "entity": "task", "classes": ["reviewer", "operator"], "relation": null, "from": ["in_review"], "to": {"by": "verdict", "map": {"passed": "in_review", "failed": "in_progress", "needs_information": "in_progress"}}, "refs": {"required": ["review"], "allowed": []}, "conditions": ["targets_current_result", "reviewer_not_author", "reviewer_is_assigned"], "effects": ["record_review"]},
    {"event": "task.closed", "entity": "task", "classes": ["coordinator", "operator"], "relation": null, "from": ["in_review"], "to": "done", "refs": {"required": [], "allowed": []}, "conditions": ["current_result_passed"], "effects": []},
    {"event": "task.reassigned", "entity": "task", "classes": ["coordinator", "operator"], "relation": null, "from": ["assigned", "in_progress", "blocked"], "to": "assigned", "refs": {"required": [], "allowed": []}, "conditions": [{"name": "target_active_class", "args": ["worker", "reviewer"]}, "target_is_not_owner"], "effects": ["set_owner", "clear_block", "count_reassignment"], "exceptable": true},
    {"event": "task.released", "entity": "task", "classes": ["worker", "reviewer"], "relation": "owner", "from": ["assigned", "in_progress", "blocked"], "to": "created", "refs": {"required": [], "allowed": ["report"]}, "conditions": [], "effects": ["clear_owner", "clear_block"], "exceptable": true},
    {"event": "task.cancelled", "entity": "task", "classes": ["operator"], "relation": null, "from": "open", "to": "cancelled", "refs": {"required": [], "allowed": []}, "conditions": [], "effects": [], "exceptable": true},
    {"event": "exception.requested", "entity": "exception", "classes": "*", "relation": null, "from": null, "to": "pending", "refs": {"required": [], "allowed": ["rationale"]}, "conditions": ["refusal_is_own", "refusal_waivable", "refusal_not_excepted"], "effects": ["create_exception"]},
    {"event": "exception.advised", "entity": "exception", "classes": ["arbiter", "coordinator", "instrument"], "relation": null, "from": ["pending"], "to": "same", "refs": {"required": [], "allowed": ["rationale"]}, "conditions": ["not_requester"], "effects": ["record_advice"]},
    {"event": "exception.granted", "entity": "exception", "classes": ["operator", "arbiter"], "relation": null, "from": ["pending"], "to": "granted", "refs": {"required": [], "allowed": ["rationale"]}, "conditions": ["not_requester", "exception_applicable"], "effects": ["decide_exception"]},
    {"event": "exception.denied", "entity": "exception", "classes": ["operator", "arbiter"], "relation": null, "from": ["pending"], "to": "denied", "refs": {"required": [], "allowed": ["rationale"]}, "conditions": ["not_requester"], "effects": ["decide_exception"]},
    {"event": "exception.withdrawn", "entity": "exception", "classes": "*", "relation": "requester", "from": ["pending"], "to": "withdrawn", "refs": {"required": [], "allowed": []}, "conditions": [], "effects": ["decide_exception"]},
    {"event": "route.table_pinned", "entity": "hive", "classes": ["instrument", "operator"], "relation": null, "from": "*", "to": "same", "refs": {"required": [], "allowed": []}, "conditions": [], "effects": []},
    {"event": "route.mode_set", "entity": "hive", "classes": ["instrument", "operator"], "relation": null, "from": "*", "to": "same", "refs": {"required": [], "allowed": []}, "conditions": [], "effects": []},
    {"event": "route.decided", "entity": "hive", "classes": ["instrument"], "relation": null, "from": "*", "to": "same", "refs": {"required": [], "allowed": []}, "conditions": [], "effects": []},
    {"event": "route.waiting", "entity": "hive", "classes": ["instrument"], "relation": null, "from": "*", "to": "same", "refs": {"required": [], "allowed": []}, "conditions": [], "effects": []},
    {"event": "route.canary_recorded", "entity": "hive", "classes": ["instrument"], "relation": null, "from": "*", "to": "same", "refs": {"required": [], "allowed": []}, "conditions": [], "effects": []},
    {"event": "route.drift_detected", "entity": "hive", "classes": ["instrument"], "relation": null, "from": "*", "to": "same", "refs": {"required": [], "allowed": []}, "conditions": [], "effects": []}
  ]
}
